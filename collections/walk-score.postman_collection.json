          "id": "3265939a-46ae-4346-ae8e-3dc216cca471",
          "name": "Get Walk Score",
          "request": {
            "name": "Get Walk Score",
            "description": {
              "content": "Returns the Walk Score, Transit Score, and Bike Score for a given location specified by coordinates and address. Walk Score is returned for all requests. Transit Score and Bike Score are optional and must be explicitly requested. Scores range from 0 (car-dependent) to 100 (walker's/transit/biker's paradise). Calls must be made from server-side scripts. API is supported in the United States and Canada.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "score"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "wsapikey",
                  "value": "<string>",
                  "description": "(Required) Your Walk Score API key"
                },
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<double>",
                  "description": "(Required) Latitude of the location"
                },
                {
                  "disabled": false,
                  "key": "lon",
                  "value": "<double>",
                  "description": "(Required) Longitude of the location"
                },
                {
                  "disabled": false,
                  "key": "address",
                  "value": "<string>",
                  "description": "(Required) URL-encoded street address of the location"
                },
                {
                  "disabled": false,
                  "key": "transit",
                  "value": "<integer>",
                  "description": "Set to 1 to include Transit Score in the response"
                },
                {
                  "disabled": false,
                  "key": "bike",
                  "value": "<integer>",
                  "description": "Set to 1 to include Bike Score in the response"
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "xml",
                  "description": "Response format. Defaults to XML if not specified"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
