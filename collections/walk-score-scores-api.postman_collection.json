          "id": "ffec8785-bf89-420b-a132-3a853b4177c6",
          "name": "Get Transit Score",
          "request": {
            "name": "Get Transit Score",
            "description": {
              "content": "Returns a Transit Score (integer 0-100) and English description for a specific city and location. The score represents relative access to public transit. A score of 100 means World-Class Transit, while lower scores indicate less transit access. All successful requests return HTTP 200 with JSON.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "transit",
                "score",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "wsapikey",
                  "value": "<string>",
                  "description": "(Required) Your Walk Score API key"
                },
                {
                  "disabled": false,
                  "key": "lat",
                  "value": "<double>",
                  "description": "(Required) Latitude to score"
                },
                {
                  "disabled": false,
                  "key": "lon",
                  "value": "<double>",
                  "description": "(Required) Longitude to score"
                },
                {
                  "disabled": false,
